# Realtime — opzionale in locale, necessario per giocare fra piu dispositivi.
#
# Senza queste variabili il gioco usa BroadcastChannel e funziona solo fra
# schede dello stesso browser: comodo per lo sviluppo, inutile con i telefoni.
#
# Come ottenerle: supabase.com -> nuovo progetto (piano gratuito) ->
# Project Settings -> API. Servono solo i messaggi realtime: nessuna tabella,
# nessuno schema, nessun dato scritto sul database.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Dominio pubblico, usato nel QR mostrato dalla TV.
# Lasciandolo vuoto viene usato l'origin corrente: di solito e gia corretto.
VITE_PUBLIC_URL=
